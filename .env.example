# RxShield Environment Configuration Example
# Copy this file to .env and insert your API keys if you wish to enable live AI explanations.
# The core safety engine, graph builder, RxNorm API, and openFDA label retrieval
# function 100% without any paid API keys.

# Optional: Google Gemini API Key for grounded patient explanations
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Key (optional)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: openFDA API Key (not required for standard use; increases rate limits)
# OPENFDA_API_KEY=your_openfda_key_here

# Optional: Supabase configuration for cloud user authentication & saved regimens
# (See docs/supabase_setup.md for full PostgreSQL schema and setup)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
